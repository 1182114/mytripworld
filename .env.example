# Copy to .env.local (never commit .env.local) and fill in.

# --- Content (required) -------------------------------------------------------
# The Sanity project that holds the website content. Not secret.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only while the Sanity project does not exist yet: build from the snapshot in
# studio/seed/content.ndjson instead. Ignored as soon as SANITY_PROJECT_ID is set.
# CONTENT_SOURCE=seed

# --- Enquiries (server only, secret) ------------------------------------------
# A Sanity token with "Editor" rights so the website can save enquiries.
SANITY_WRITE_TOKEN=

# Optional email alert for each enquiry, sent through Resend (resend.com).
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
ENQUIRY_FROM_EMAIL=

# --- Addresses (optional) -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://mytripworld.net
NEXT_PUBLIC_ADMIN_URL=https://mytripworld.sanity.studio
