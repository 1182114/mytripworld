# Copy this file to .env and fill in the project ID from sanity.io/manage
# (the ID is not a secret; it also appears in the Studio web address).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# The live website address, used for the "Open page on website" links.
SANITY_STUDIO_SITE_URL=https://mytripworld.net
